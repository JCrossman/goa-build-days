{
  "name": "goa-build-days",
  "private": true,
  "type": "module",
  "engines": { "node": "24.x" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc && node scripts/build.mjs",
    "start": "node dist/src/web/server.js",
    "dev": "npm run build && npm start",
    "test": "node --test --test-reporter=tap dist/tests/*.test.js",
    "test:browser": "playwright test",
    "foundry": "node dist/examples/foundry-native.js",
    "compile:workflows": "node scripts/compile-workflows.mjs"
  },
  "dependencies": {
    "@azure/ai-projects": "2.9.0",
    "@azure/core-auth": "1.11.0",
    "@azure/identity": "4.14.0",
    "@fastify/cookie": "11.1.3",
    "@fastify/static": "10.1.6",
    "fastify": "5.12.7",
    "openai": "7.28.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@azure/core-rest-pipeline": "1.25.0",
    "@types/node": "24.19.2",
    "typescript": "5.9.3"
  }
}
